# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Trigger.dev cache
.trigger/
.env*.local

# AI assistant config (Claude Code, Cursor, etc.)
CLAUDE.md
AGENTS.md
.cursorrules
.cursor/

# Local debug scripts
scripts/test-*.mjs
scripts/check-*.mjs
